    {
      "source": "/mcp/overview",
      "destination": "/mcp/lender"
    },
    {
      "source": "/mcp/setup",
      "destination": "/mcp/lender"
    },
    {
      "source": "/mcp/tools",
      "destination": "/mcp/marketplace"
    },
    {
      "source": "/mcp/financial-services",
      "destination": "/mcp/marketplace"
